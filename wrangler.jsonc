{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "becore-tickets",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "tickets.becoreops.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "becore-tickets-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "THE_ROOM",
        "class_name": "TheRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TheRoom"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
