{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "becore-tickets",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "tickets.becoreops.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "EMAIL_FROM": "BeCore Tickets <tickets@tickets.becoreops.com>",
    "OPS_ALERT_EMAIL": "tickets@becoreops.com",
    "ENVIRONMENT": "production",
    "VAPID_SUBJECT": "mailto:tickets@tickets.becoreops.com"
  },
  "triggers": {
    "crons": ["*/5 * * * *", "15 3 * * *"]
  },
  "images": {
    "binding": "IMAGES"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "./drizzle"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "83101",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "PUBLIC_WRITE_RATE_LIMITER",
      "namespace_id": "83102",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "PAYMENT_RATE_LIMITER",
      "namespace_id": "83103",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "THE_ROOM",
        "class_name": "TheRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TheRoom"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
