{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "becore-tickets",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "routes": [
    {
      "pattern": "tickets.becoreops.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "EMAIL_FROM": "BeCore Tickets <tickets@tickets.becoreops.com>",
    "OPS_ALERT_EMAIL": "tickets@becoreops.com",
    "ENVIRONMENT": "production",
    "AI_COST_CONTROL_REQUIRED": "true",
    "OPENAI_GATEWAY_BASE_URL": "https://gateway.ai.cloudflare.com/v1/af75a230de2eea882606db8d9acce473/becore-tickets-ai/openai",
    "VAPID_SUBJECT": "mailto:tickets@tickets.becoreops.com"
  },
  "triggers": {
    "crons": ["* * * * *", "*/5 * * * *", "15 3 * * *"]
  },
  "images": {
    "binding": "IMAGES"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "./drizzle"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EMAIL_DELIVERY_QUEUE",
        "queue": "becore-tickets-email-delivery"
      }
    ],
    "consumers": [
      {
        "queue": "becore-tickets-email-delivery",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 2,
        "max_concurrency": 1,
        "retry_delay": 60
      }
    ]
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "83101",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "PUBLIC_WRITE_RATE_LIMITER",
      "namespace_id": "83102",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "PAYMENT_RATE_LIMITER",
      "namespace_id": "83103",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "ANALYTICS_RATE_LIMITER",
      "namespace_id": "83104",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "83105",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "THE_ROOM",
        "class_name": "TheRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TheRoom"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
