{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "next/link": [
        "./src/adapters/link.tsx"
      ],
      "next/image": [
        "./src/adapters/image.tsx"
      ],
      "next/navigation": [
        "./src/adapters/navigation.tsx"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ],
      "lucide-react": [
        "./node_modules/lucide-react"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "*.ts"
  ]
}
