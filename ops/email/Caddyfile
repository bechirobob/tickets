mail.becoreops.com {
    header {
        Cache-Control "no-store"
        X-Robots-Tag "noindex, nofollow"
        X-Content-Type-Options "nosniff"
        -Server
    }
    request_body {
        max_size 256KB
    }
    @mail path /healthz /v1/emails /v1/status
    handle @mail {
        reverse_proxy 127.0.0.1:8826
    }
    handle {
        respond "Not found" 404
    }
}
