[Unit]
Description=BeCore Tickets isolated VPS readiness service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=becore-tickets
Group=becore-tickets
WorkingDirectory=/srv/becore-tickets/current
Environment=NODE_ENV=production
Environment=TICKETS_ACTIVE=0
Environment=TICKETS_CONFIG=/etc/becore-tickets/preview.json
Environment=TICKETS_STATE=/var/lib/becore-tickets-preview
Environment=TICKETS_HOST=tickets.becoreops.com
Environment=TICKETS_PORT=3118
ExecStart=/usr/bin/flock --nonblock /var/lib/becore-tickets-preview/instance.lock /usr/bin/node /srv/becore-tickets/current/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
CapabilityBoundingSet=
StateDirectory=becore-tickets-preview
StateDirectoryMode=0700
ReadWritePaths=/var/lib/becore-tickets-preview
IPAddressDeny=any
IPAddressAllow=localhost
MemoryHigh=768M
MemoryMax=1G
CPUQuota=150%
TasksMax=128
LimitNOFILE=4096
LogNamespace=becore-tickets
LogRateLimitIntervalSec=60
LogRateLimitBurst=120

[Install]
WantedBy=multi-user.target
