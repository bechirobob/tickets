{
  "name": "becore-tickets",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-build.mjs && vinext build",
    "start": "vinext start",
    "test": "npm run test:ui && npm run test:password-client && npm run test:rendered && npm run test:worker",
    "test:ui": "node --test tests/mobile-ui.test.mjs",
    "test:password-client": "node --test tests/staff-password-client.test.mjs",
    "test:rendered": "npm run build && node scripts/prepare-deploy.mjs && node --test tests/rendered-html.test.mjs",
    "test:worker": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:production": "E2E_BASE_URL=https://tickets.becoreops.com playwright test",
    "recovery:rehearse": "bash scripts/rehearse-d1-recovery.sh",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern .wrangler --ignore-pattern '.release-dry-run*' --ignore-pattern 'rbac-dry-run*' --ignore-pattern 'live-audit.*' --ignore-pattern 'workers-types-latest.*' --ignore-pattern '.tmp-*' --ignore-pattern worker-configuration.d.ts",
    "typecheck": "tsc --noEmit",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "deploy:built": "node scripts/prepare-deploy.mjs && wrangler deploy --config dist/server/wrangler.json",
    "deploy": "npm run build && npm run db:migrate:remote && npm run deploy:built",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.3.0",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push-neo": "0.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.51.2",
    "@cloudflare/vitest-pool-workers": "0.21.0",
    "@cloudflare/workers-types": "5.20260811.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "26.2.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.120.1"
  },
  "type": "module"
}
