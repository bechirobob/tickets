{
  "name": "becore-tickets",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-build.mjs && vinext build",
    "start": "vinext start",
    "test": "npm run test:tooling && npm run test:repo && npm run test:ui && npm run test:password-client && npm run test:rendered && npm run test:worker",
    "test:repo": "node --test tests/repository-boundaries.test.mjs tests/owner-recovery-issuer.test.mjs tests/app-navigation.test.mjs tests/wallet-provider-actions.test.mjs tests/customer-email-rendering.test.mjs",
    "test:ui": "node --test tests/mobile-ui.test.mjs",
    "test:password-client": "node --test tests/staff-password-client.test.mjs",
    "test:rendered": "npm run build && node scripts/prepare-deploy.mjs && node --test tests/rendered-html.test.mjs",
    "test:worker": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:production": "E2E_BASE_URL=https://tickets.becoreops.com playwright test",
    "recovery:rehearse": "bash scripts/rehearse-d1-recovery.sh",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern .wrangler --ignore-pattern '.release-dry-run*' --ignore-pattern 'rbac-dry-run*' --ignore-pattern 'live-audit.*' --ignore-pattern 'workers-types-latest.*' --ignore-pattern '.tmp-*' --ignore-pattern worker-configuration.d.ts",
    "typecheck": "tsc --noEmit",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "deploy:built": "node scripts/prepare-deploy.mjs && wrangler deploy --config dist/server/wrangler.json",
    "deploy": "npm run build && npm run db:migrate:remote && npm run deploy:built",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test:capacity": "vitest run --config vitest.capacity.config.ts",
    "build:vps": "node scripts/build-vps.mjs",
    "test:vps": "node --test tests/vps-runtime-packaging.test.mjs tests/vps-database.test.mjs tests/vps-operations.test.mjs tests/vps-moderation-client.test.mjs tests/handover-room-return.test.mjs tests/handover-database-transfer.test.mjs tests/handover-envelope.test.mjs tests/handover-data.test.mjs tests/handover-rpc.test.mjs && vitest run --config vitest.vps.config.ts",
    "test:tooling": "node --test tests/tooling-glob.test.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.3.6",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.5",
    "vinext": "1.0.0-beta.9",
    "web-push-neo": "0.1.2",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20261003.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0",
    "@next/eslint-plugin-next": "file:vendor/eslint-plugin-next",
    "vite-plugin-dynamic-import": "file:vendor/vite-plugin-dynamic-import",
    "@becoreops/tooling-glob": "file:vendor/tooling-glob",
    "glob": "13.0.6"
  },
  "overrides": {
    "sharp": "0.35.5",
    "js-yaml": "4.3.2",
    "browserslist": "4.28.7",
    "fast-uri": "3.1.8",
    "undici": "7.29.1",
    "fflate": "0.7.5",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "@next/eslint-plugin-next": "$@next/eslint-plugin-next",
    "vite-plugin-dynamic-import": "$vite-plugin-dynamic-import"
  },
  "type": "module"
}
